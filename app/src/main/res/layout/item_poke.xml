<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/pokeCard"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/pokemonImageView"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"/>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/namePokeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name Pokemon"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                
                <TextView
                    android:id="@+id/genusPokemonTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Short Description"
                    android:textSize="18dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <ImageView
                        android:id="@+id/type1ImageView"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="fitCenter"/>
                    
                    <ImageView
                        android:id="@+id/type2ImageView"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"/>
                    
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    
                    <TextView
                        android:id="@+id/pokedexNumTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#000"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    
                </LinearLayout>
                
            </LinearLayout>



        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>